{
  "name": "playwright-pact-xray",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright (TypeScript) UI, API and accessibility tests, a Pact consumer contract test, a k6 performance smoke test, GitHub Actions CI and Xray reporting.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:contract": "playwright test --project=contract",
    "test:a11y": "playwright test --project=ui --grep @a11y",
    "test:perf": "k6 run perf/booking-smoke.js",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report reports/html",
    "xray:import": "bash scripts/xray-import.sh reports/junit.xml"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
